"""Refresh the cached Threat Shield entitlement after a subscription change."""

import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))

import threat_shield

# No bust: an unreachable server must not erase the last verdict.
status = threat_shield.probe_status(refresh=True)
