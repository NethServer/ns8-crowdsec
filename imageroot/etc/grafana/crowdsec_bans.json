          "editorMode": "code",
          "expr": "topk(300, sum by (lat, lon, country) (count_over_time({module_id=~\"$crowdsec\"} |= \"export-alerts\" | json SYSLOG_IDENTIFIER, MESSAGE | SYSLOG_IDENTIFIER=~\".+-export-alerts\" | line_format \"{{.MESSAGE}}\" | json | __error__=\"\" | v=\"1\" | country=~\"$country\" | service=~\"$service\" | lat!=\"\" [$__range])))",
