# Purge CAPI decisions when Central API or community blocklist pull is disabled

input=$(cat)

if echo "$input" | jq -e '.enable_online_api == false or .pull_community_blocklist == false' > /dev/null; then
    podman exec "$MODULE_ID" cscli decisions delete --all --origin CAPI || true
    # flush nft sets immediately — bouncer sync can take several seconds
    nft flush set ip crowdsec crowdsec-blacklists-CAPI 2>/dev/null || true
    nft flush set ip6 crowdsec6 crowdsec6-blacklists-CAPI 2>/dev/null || true
fi
