# Unban IP address(es) in CrowdSec
# Usage:
#   - action: "unban", ip: "<IP_ADDRESS>" to delete the temporary bans of an IP;
#     permanent bans follow the local blocklist (set-local-blocklist)
#   - action: "unban_all" to unban all IPs

exec 4>&1
exec 1>&2
set -e

readarray -t input < <(jq -r '.action, .ip')
action=${input[0]:?missing action argument}
ip=${input[1]:?missing ip argument}
rc=0

if [[ "$action" == "unban" ]]; then
    set -o pipefail
    # cscli decisions list shows an address once, so read the active decisions
    # of all its alerts (an import alert holds other addresses too);
    # Threat Shield imports are never touched here.
    podman exec "${MODULE_ID}" cscli alerts list --ip "${ip}" --limit 0 -o json \
        | jq -r --arg ip "${ip}" '.[]?.decisions[]?
            | select(.value == $ip)
            | select((.duration // "-") | startswith("-") | not)
            | select((.scenario // "") | startswith("threat-shield/") | not)
            | select((.scenario // "") | startswith("permanent:") | not)
            | .id' \
        | while read -r id; do
            podman exec "${MODULE_ID}" cscli decisions delete --id "${id}" </dev/null
        done
elif [[ "$action" == "unban_all" ]]; then
    set -o pipefail
    # Delete active temporary bans by id from all alerts: decisions list hides an address behind its newest alert.
    podman exec "${MODULE_ID}" cscli alerts list --limit 0 -o json \
        | jq -r '[.[]?.decisions[]?
            | select((.duration // "-") | startswith("-") | not)
            | select((.origin // "") | IN("CAPI", "lists") | not)
            | select((.scenario // "") | startswith("threat-shield/") or startswith("permanent:") | not)
            | .id] | unique[]' \
        | podman exec -i "${MODULE_ID}" xargs -r -l -P10 cscli decision delete --id &>/dev/null || rc=$?
else
    echo "Unknown action: $action"
    exit 1
fi

# The Threat Shield import keeps a copy of every ban: drop the unbanned ones now.
refresh-threat-shield-firewall || :
exit "${rc}"
