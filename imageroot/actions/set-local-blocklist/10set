"""Save the local blocklist and ban its addresses permanently."""

import ipaddress
import json
import os
import subprocess
import sys

import agent


def fail(value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": "local_blocklist", "parameter": "local_blocklist",
                "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


request = json.load(sys.stdin)
addresses = []
for line in request["local_blocklist"]:
    line = line.strip()
    if not line:
        continue
    # Single addresses only: the nftables bouncer strips network prefixes.
    try:
        address = ipaddress.ip_address(line)
        if getattr(address, "scope_id", None):  # "fe80::1%eth0" parses but cscli rejects it
            raise ValueError(line)
        ip = str(address)
    except ValueError:
        fail(line, "not_valid")
    if ip not in addresses:
        addresses.append(ip)

for ip in addresses:
    check = subprocess.run(["podman", "exec", os.environ["MODULE_ID"], "cscli", "allowlists", "check", ip],
                           check=True, stdout=subprocess.PIPE, stderr=sys.stderr, text=True).stdout
    if " is allowlisted by " in check:
        fail(ip, "ip_allowlisted")

agent.set_env("LOCAL_BLOCKLIST", ",".join(addresses))
# The sync reads the new value from its environment.
env = dict(os.environ, LOCAL_BLOCKLIST=",".join(addresses))
subprocess.run(["sync-local-blocklist"], env=env, stdout=sys.stderr, check=True)
json.dump({}, fp=sys.stdout)
