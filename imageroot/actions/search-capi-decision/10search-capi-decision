# Search for a specific IP in CAPI decisions — server-side filtering, fast

set -e

input=$(cat)
ip=$(echo "$input" | jq -r '.ip')

# Filter by IP server-side: `cscli decisions list` caps at 100 rows by default,
# so scanning the whole CAPI community list (tens of thousands of IPs) client-side
# would miss any IP past the first 100. `--ip` returns only the matching decisions.
list=$(podman exec "$MODULE_ID" cscli decisions list --ip "$ip" --origin CAPI --output json)

if [[ $list == 'null' || $list == '[]' || -z $list ]]; then
    jq -n '{found: false, decisions: []}'
    exit 0
fi

decisions=$(echo "$list" | jq --arg ip "$ip" '
  if (.[0] | has("decisions")) then
    [.[].decisions // [] | .[] | select(.value == $ip)]
  else
    [.[] | select(.value == $ip)]
  end
')
if [[ $(echo "$decisions" | jq 'length') -gt 0 ]]; then
    jq -n --argjson d "$decisions" '{found: true, decisions: $d}'
else
    jq -n '{found: false, decisions: []}'
fi
