#
# list the active permanent bans

set -e

# Read the manual alerts: cscli decisions list shows an address once, under
# its newest alert, so a newer ban of the same address could hide a permanent one.
podman exec $MODULE_ID cscli alerts list --origin cscli --limit 0 --output json | jq -c '
    [.[]? | .decisions = ((.decisions // []) | map(select(
        ((.scenario // "") | startswith("permanent:"))
        and ((.duration // "-") | startswith("-") | not))))
    | select(.decisions | length > 0)]'
