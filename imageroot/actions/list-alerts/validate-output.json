{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-alerts output",
    "$id": "http://schema.nethserver.org/crowdsec/list-alerts-output.json",
    "description": "List of CrowdSec detection alerts",
    "examples": [
        [
            {
                "id": 42,
                "created_at": "2026-01-15T10:23:00Z",
                "scenario": "crowdsecurity/ssh-bf",
                "simulated": false,
                "events_count": 5,
                "source": {
                    "ip": "1.2.3.4",
                    "cn": "US",
                    "as_name": "Example ISP"
                },
                "decisions": [
                    {
                        "type": "ban",
                        "duration": "24h0m0s"
                    }
                ]
            }
        ]
    ],
    "type": "array",
    "items": {
        "type": "object",
        "required": ["id", "created_at", "scenario", "simulated", "events_count", "source"],
        "properties": {
            "id": {
                "type": "integer",
                "title": "id",
                "description": "Unique alert identifier"
            },
            "created_at": {
                "type": "string",
                "title": "created_at",
                "description": "Timestamp when the alert was created"
            },
            "scenario": {
                "type": "string",
                "title": "scenario",
                "description": "CrowdSec scenario that triggered the alert"
            },
            "simulated": {
                "type": "boolean",
                "title": "simulated",
                "description": "Whether the alert is in simulation mode only"
            },
            "events_count": {
                "type": "integer",
                "title": "events_count",
                "description": "Number of events that triggered the alert"
            },
            "source": {
                "type": "object",
                "title": "source",
                "description": "Origin of the alert",
                "properties": {
                    "ip": {
                        "type": "string",
                        "title": "ip",
                        "description": "Source IP address"
                    },
                    "cn": {
                        "type": ["string", "null"],
                        "title": "cn",
                        "description": "Country code of the source IP"
                    },
                    "as_name": {
                        "type": ["string", "null"],
                        "title": "as_name",
                        "description": "Autonomous system name of the source IP"
                    }
                }
            },
            "decisions": {
                "type": ["array", "null"],
                "title": "decisions",
                "description": "Decisions taken in response to this alert",
                "items": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "title": "type",
                            "description": "Decision type (e.g. ban)"
                        },
                        "duration": {
                            "type": "string",
                            "title": "duration",
                            "description": "Remaining ban duration (e.g. 24h0m0s)"
                        }
                    }
                }
            }
        }
    }
}
