import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))

import agent
import threat_shield


def decision_counts():
    """Active decisions per feed, from one listing filtered here: the default
    listing skips CAPI, which keeps it fast. --limit 0 lifts the 100-row cap."""
    counts = {}
    try:
        result = subprocess.run(
            ["podman", "exec", os.environ["MODULE_ID"], "cscli", "decisions", "list",
             "--limit", "0", "--output", "json"],
            check=True, capture_output=True, text=True,
        )
    except subprocess.CalledProcessError as err:
        print(agent.SD_WARNING + f"cannot list Threat Shield decisions: {err.stderr}",
              file=sys.stderr)
        return counts

    try:
        listed = json.loads(result.stdout or "null") or []
    except ValueError:
        return counts

    for row in listed:
        # Decisions come either grouped under alerts or flat.
        for decision in (row.get("decisions") or [row]):
            scenario = decision.get("scenario", "")
            if scenario.startswith(threat_shield.SCENARIO_PREFIX):
                key = scenario[len(threat_shield.SCENARIO_PREFIX):]
                counts[key] = counts.get(key, 0) + 1
    return counts


catalog = threat_shield.load_catalog()
enabled = set(threat_shield.enabled_feeds(catalog))
counts = decision_counts()

system_id, auth_token = threat_shield.identity()
has_subscription = bool(system_id) and bool(auth_token)
if has_subscription:
    # Re-probe only while the cached verdict is "no", so the page stays fast.
    probe = threat_shield.probe_status(refresh=not threat_shield.cached_probe_status()["entitled"])
else:
    probe = {"entitled": False, "type": None}
enterprise = probe.get("type") == "enterprise"

feeds = [
    {
        "key": key,
        "description": entry.get("descr", key),
        "enabled": key in enabled,
        "count": counts.get(key, 0),
        "confidence": threat_shield.get_confidence(key, enterprise),
    }
    for key, entry in catalog.items()
]

output = {
    "subscription": has_subscription,
    "entitled": bool(probe.get("entitled")),
    "type": probe.get("type") or "",
    "feeds": feeds,
}

# Missing until the timer has run once. Each feed is stamped with the run
# timestamp, as the UI reads it per feed.
try:
    with open("threat_shield_last_import.json") as fp:
        status = json.load(fp)
except (FileNotFoundError, ValueError):
    status = None

if status is not None:
    timestamp = status.get("timestamp")
    output["last_import"] = {
        "timestamp": timestamp,
        "error": status.get("error"),
        "feeds": {
            key: dict(feed, timestamp=timestamp)
            for key, feed in (status.get("feeds") or {}).items()
        },
    }

json.dump(output, fp=sys.stdout)
