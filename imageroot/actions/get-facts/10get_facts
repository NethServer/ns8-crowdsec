"""Inventory facts: environment and state files only, no container, no network."""

import json
import os
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))

import agent
import threat_shield


def count_env_list(name):
    return len([v for v in os.getenv(name, "").split(",") if v.strip()])


has_recipients = count_env_list("RECEIVER_EMAILS") > 0
smarthost = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))

capi_enabled = os.getenv("DISABLE_ONLINE_API", "False") == "False"

facts = {
    "dynamic_bantime": os.getenv("DYN_BANTIME", "True") == "True",
    "ban_local_network": os.getenv("BAN_LOCAL_NETWORK", "False") == "True",
    "capi_enabled": capi_enabled,
    "pull_community_blocklist": os.getenv("PULL_COMMUNITY_BLOCKLIST", "True") == "True",
    "console_enrolled": capi_enabled and bool(os.getenv("ENROLL_INSTANCE", "")),
    "nethvoice_collection": os.getenv("NETHVOICE_COLLECTION_ENABLED", "True") == "True",
    "email_notifications": has_recipients and smarthost["enabled"],
    "whitelist_count": count_env_list("WHITELISTS"),
}

try:
    feeds = threat_shield.enabled_feeds(threat_shield.load_catalog())
    facts["threat_shield_enterprise"] = len(feeds)
    facts["threat_shield_feeds"] = feeds
except Exception as ex:
    # Partial facts beat none: an exception here drops the whole module.
    print(agent.SD_WARNING + f"threat shield facts failed: {ex}", file=sys.stderr)

json.dump(facts, fp=sys.stdout)
