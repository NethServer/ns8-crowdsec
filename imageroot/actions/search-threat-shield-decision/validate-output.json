{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://schema.nethserver.org/crowdsec/search-threat-shield-decision-output.json",
    "title": "search-threat-shield-decision output",
    "description": "Whether the searched IP is covered by a Nethesis Threat Shield decision, with the matching decisions",
    "examples": [
        {
            "found": true,
            "decisions": [
                {
                    "id": 91002,
                    "origin": "cscli-import",
                    "scenario": "threat-shield/nethesislvl3",
                    "scope": "Ip",
                    "type": "ban",
                    "duration": "6h59m2s",
                    "value": "185.220.101.0/24",
                    "simulated": false
                }
            ]
        },
        {
            "found": false,
            "decisions": []
        }
    ],
    "type": "object",
    "required": ["found", "decisions"],
    "properties": {
        "found": {
            "type": "boolean",
            "title": "found",
            "description": "True if at least one Threat Shield decision covers the IP"
        },
        "decisions": {
            "type": "array",
            "title": "decisions",
            "description": "Threat Shield decisions matching the searched IP",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "id",
                        "description": "Unique decision identifier"
                    },
                    "origin": {
                        "type": "string",
                        "title": "origin",
                        "description": "Source of the decision, always cscli-import here"
                    },
                    "scenario": {
                        "type": "string",
                        "title": "scenario",
                        "description": "Scenario tag, threat-shield/<feed key>"
                    },
                    "scope": {
                        "type": "string",
                        "title": "scope",
                        "description": "Scope of the decision (e.g. Ip, Range)"
                    },
                    "type": {
                        "type": "string",
                        "title": "type",
                        "description": "Decision type (e.g. ban)"
                    },
                    "duration": {
                        "type": "string",
                        "title": "duration",
                        "description": "Remaining ban duration"
                    },
                    "value": {
                        "type": "string",
                        "title": "value",
                        "description": "IP or CIDR targeted by the decision"
                    },
                    "simulated": {
                        "type": "boolean",
                        "title": "simulated",
                        "description": "Whether the decision is in simulation mode only"
                    }
                }
            }
        }
    }
}
