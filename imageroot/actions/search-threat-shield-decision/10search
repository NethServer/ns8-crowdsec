"""Look an address up in the Threat Shield decisions.

Python rather than jq: the feeds carry CIDRs, so an exact string match would
miss an address banned as part of a /24.
"""

import ipaddress
import json
import os
import subprocess
import sys

import agent

SCENARIO_PREFIX = "threat-shield/"

request = json.load(sys.stdin)

try:
    needle = ipaddress.ip_address(request["ip"].strip())
except ValueError:
    agent.set_status("validation-failed")
    json.dump([{
        "field": "ip",
        "parameter": "ip",
        "value": request.get("ip", ""),
        "error": "not_valid",
    }], fp=sys.stdout)
    sys.exit(3)

# --limit 0 removes the default 100-row cap. We deliberately do NOT pass --ip:
# on IPv4 it triggers a range-containment lookup that hangs on large datasets,
# the same reason search-capi-decision avoids it.
result = subprocess.run(
    ["podman", "exec", os.environ["MODULE_ID"], "cscli", "decisions", "list",
     "--origin", "cscli-import", "--limit", "0", "--output", "json"],
    check=True, capture_output=True, text=True,
)

try:
    listed = json.loads(result.stdout or "null") or []
except ValueError:
    listed = []

matches = []
for row in listed:
    # cscli groups decisions under an alert when the LAPI returns alerts, and
    # returns them flat otherwise.
    for decision in (row.get("decisions") or [row]):
        scenario = decision.get("scenario", "")
        if not scenario.startswith(SCENARIO_PREFIX):
            continue
        try:
            network = ipaddress.ip_network(decision.get("value", ""), strict=False)
        except ValueError:
            continue
        if needle.version == network.version and needle in network:
            matches.append(decision)

json.dump({"found": bool(matches), "decisions": matches}, fp=sys.stdout)
