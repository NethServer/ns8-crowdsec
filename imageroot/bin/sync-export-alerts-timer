# Follow the export_bans setting of configure-module.
if [[ "${EXPORT_BANS:-True}" == "True" ]]; then
    systemctl enable --now "${MODULE_ID}-export-alerts.timer"
else
    systemctl disable --now "${MODULE_ID}-export-alerts.timer"
fi
