"""Enable the Threat Shield import timer only when the subscription has an
identity or a custom list exists: otherwise there is nothing to import."""

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin"))

import threat_shield

system_id, auth_token = threat_shield.identity()
timer = f"{os.environ['MODULE_ID']}-threat-shield.timer"

try:
    lists = threat_shield.load_lists()
    has_lists = bool(lists["allowlists"] or lists["blocklists"])
except ValueError:
    # Broken file: keep the timer, the import reports it.
    has_lists = True

if (system_id and auth_token) or has_lists:
    subprocess.run(["systemctl", "enable", "--now", timer], check=True)
else:
    # A running import keeps going; the subscription-changed restart cleans up.
    subprocess.run(["systemctl", "disable", "--now", timer], check=True)
